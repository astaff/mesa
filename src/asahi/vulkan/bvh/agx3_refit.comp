 *
 * Retained jobs of updatable structures (see hk_agx3_retained_job).
 * HK_AGX3_REFIT_SAVE keeps a full build's encoding jobs after its image, one
 * thread per job. HK_AGX3_REFIT_PREPARE readies an update, after its leaves:
 * it finds the source's jobs, copies them when updating into another
 * structure, clears the arrival counters and writes the refit state and the
 * envelope job. HK_AGX3_REFIT_PROPAGATE encodes the inner jobs after refit
 * encoding has encoded the leaf jobs, one thread per job.
 *
 * Propagation runs apart from encoding: its device-scope arrivals wait for
 * the thread's earlier global stores, which in node encoding are a whole
 * node's.
 */
#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float32 : require
#include "hk_build_interface.h"
#include "agx3_node.h"
layout(local_size_x = HK_AGX3_REFIT_GROUP_SIZE) in;
layout(push_constant) uniform CONSTS { hk_agx3_refit_args args; };

uint
leaf_size()
{
   return args.geometry_type == VK_GEOMETRY_TYPE_INSTANCES_KHR
             ? SIZEOF(vk_ir_instance_node)
             : args.geometry_type == VK_GEOMETRY_TYPE_AABBS_KHR
                ? SIZEOF(vk_ir_aabb_node) : SIZEOF(vk_ir_triangle_node);
}

/* Plan node of the IR node at `offset` (an IR leaf or internal node). */
uint
node_index(uint offset)
{
   return offset < args.root_offset
             ? offset / leaf_size()
             : args.leaf_bound + (offset - args.root_offset) / SIZEOF(vk_ir_box_node);
}

void
save(uint id)
{
   hk_agx3_plan_state plan = DEREF(REF(hk_agx3_plan_state)(args.plan_state));
   uint jobs = plan.job_count;
   REF(hk_agx3_retained_state) state = REF(hk_agx3_retained_state)(args.retained);
   uint64_t records = args.retained + uint64_t(HK_AGX3_RETAINED_STATE_BYTES);
   uint64_t offsets = records + uint64_t(jobs) * uint64_t(HK_AGX3_RETAINED_JOB_BYTES);
   if (id == 0) {
      uint root = args.leaf_bound + DEREF(args.header).ir_internal_node_count - 1u;
      hk_agx3_retained_state saved;
      saved.job_count = jobs;
      saved.root_job = jobs != 0u && root < args.node_bound
         ? DEREF(INDEX(hk_agx3_plan_node, args.plan_nodes, root)).job : 0xffffffffu;
      saved.end_slot = plan.next_slot;
      saved.depth = plan.depth;
      for (uint i = 0; i < 4; ++i)
         saved.reserved[i] = 0;
      DEREF(state) = saved;
   }
   if (id >= jobs)
      return;
   hk_agx3_leaf_job job = DEREF(INDEX(hk_agx3_leaf_job, args.plan_jobs, id));
   uint count = min(job.child_count, 8u);
   REF(hk_agx3_retained_job) record = INDEX(hk_agx3_retained_job, records, id);
   uint first;
   if (job.node_kind == HK_AGX3_NODE_INNER) {
      first = atomicAdd(DEREF(REF(hk_agx3_plan_state)(args.plan_state)).saved_positions, count);
      for (uint c = 0; c < count; ++c) {
         uint child = DEREF(INDEX(hk_agx3_plan_node, args.plan_nodes,
                                  node_index(job.triangle_offsets[c]))).job;
         if (child >= jobs)
            continue;
         REF(hk_agx3_retained_job) child_record = INDEX(hk_agx3_retained_job, records, child);
         DEREF(child_record).parent = id;
         DEREF(child_record).position = first + c;
      }
   } else {
      first = atomicAdd(DEREF(REF(hk_agx3_plan_state)(args.plan_state)).saved_offsets, count);
      for (uint c = 0; c < count; ++c)
         DEREF(INDEX(uint32_t, offsets, first + c)) = job.triangle_offsets[c];
   }
   DEREF(record).root_slot = job.root_slot;
   DEREF(record).child_slot = job.child_slot;
   DEREF(record).kind_count = job.child_count | (job.node_kind << 4);
   DEREF(record).first = first;
   if (job.root_slot == 0u) {
      DEREF(record).parent = 0xffffffffu;
      DEREF(record).position = jobs - 1u;
   }
}

void
prepare(uint id)
{
   uint64_t source = args.retained;
   if (args.metadata != 0ul) {
      libagx_gen1_as_metadata live = DEREF(REF(libagx_gen1_as_metadata)(args.metadata));
      source = live.native_base + live.retained_offset;
   }
   hk_agx3_retained_state saved = DEREF(REF(hk_agx3_retained_state)(source));
   uint jobs = saved.job_count;
   if (args.copy != 0u) {
      /* An update into another structure keeps it updatable: copy the state,
       * the records and every child offset the leaf jobs may use. */
      uint words = HK_AGX3_RETAINED_BYTES(jobs, args.leaf_bound) / 4u;
      if (id < words)
         DEREF(INDEX(uint32_t, args.retained, id)) = DEREF(INDEX(uint32_t, source, id));
   }
   if (id < jobs)
      DEREF(INDEX(uint32_t, args.counters, id)) = 0u;

   bool instances = args.geometry_type == VK_GEOMETRY_TYPE_INSTANCES_KHR;
   uint64_t transforms = uint64_t(saved.end_slot) * 64ul;
   uint64_t pointers = transforms + 64ul * uint64_t(args.leaf_bound);
   /* Instance encoding fills the pointer of every active instance. */
   if (instances && jobs != 0u && id < args.leaf_bound) {
      uint64_t entry = args.output_bvh + pointers + uint64_t(id) * 16ul;
      DEREF(REF(uint64_t)(entry)) = 0ul;
      DEREF(REF(uint64_t)(entry + 8ul)) = 0ul;
   }
   if (id != 0)
      return;
   hk_agx3_refit_state refit;
   refit.dispatch[0] = (jobs + HK_AGX3_NODE_JOBS_PER_GROUP - 1u) / HK_AGX3_NODE_JOBS_PER_GROUP;
   refit.dispatch[1] = 1u;
   refit.dispatch[2] = 1u;
   refit.job_count = jobs;
   refit.retained = args.copy != 0u ? args.retained : source;
   refit.propagate[0] = (jobs + HK_AGX3_REFIT_GROUP_SIZE - 1u) / HK_AGX3_REFIT_GROUP_SIZE;
   refit.propagate[1] = 1u;
   refit.propagate[2] = 1u;
   refit.end_slot = saved.end_slot;
   DEREF(REF(hk_agx3_refit_state)(args.refit)) = refit;

   uint active_leaves = DEREF(args.header).active_leaf_count;
   bool empty = jobs == 0u || active_leaves == 0u;
   hk_agx3_envelope_job job;
   job.bounds = REF(vk_ir_node)(args.bounds + uint64_t(jobs != 0u ? jobs - 1u : 0u) *
                                uint64_t(SIZEOF(vk_aabb)));
   job.output_bvh = args.output_bvh;
   job.end_slot = saved.end_slot;
   job.primitive_count = empty ? 0u : active_leaves;
   job.node_count = jobs;
   job.depth = saved.depth;
   job.opaque_build_word = empty ? HK_AGX3_PLAN_EMPTY : 0u;
   job.resource_id = args.resource_id;
   job.geometry_type = args.geometry_type;
   job.leaf_bound = args.leaf_bound;
   DEREF(REF(hk_agx3_envelope_job)(args.envelope)) = job;
}

/* From leaf job `id`, whose bounds refit encoding left at its position:
 * arrive at the parent; while this was the parent's last child, encode the
 * parent's node from its children's bounds, leave the parent's bounds at
 * its position and arrive at its parent in turn. The arrival orders the
 * bounds stores of every child before the reads of the last. */
void
propagate(uint id)
{
   hk_agx3_refit_state refit = DEREF(REF(hk_agx3_refit_state)(args.refit));
   if (id >= refit.job_count)
      return;
   uint64_t records = refit.retained + uint64_t(HK_AGX3_RETAINED_STATE_BYTES);
   hk_agx3_retained_job leaf = DEREF(INDEX(hk_agx3_retained_job, records, id));
   if ((leaf.kind_count >> 4) == HK_AGX3_NODE_INNER)
      return;
   uint parent = leaf.parent;
   for (uint steps = 0; parent != 0xffffffffu && steps < 64u; ++steps) {
      hk_agx3_retained_job job = DEREF(INDEX(hk_agx3_retained_job, records, parent));
      uint count = job.kind_count & 15u;
      uint arrived = atomicAdd(DEREF(INDEX(uint32_t, args.counters, parent)), 1u,
         gl_ScopeDevice, gl_StorageSemanticsBuffer,
         gl_SemanticsAcquireRelease | gl_SemanticsMakeAvailable | gl_SemanticsMakeVisible);
      if (arrived + 1u != count)
         return;
      vec3 child_lo[8], child_hi[8];
      vec3 lo = vec3(INFINITY), hi = vec3(-INFINITY);
      for (uint c = 0; c < count && c < 8u; ++c) {
         child_lo[c] = DEREF(INDEX(vk_aabb, args.bounds, job.first + c)).min;
         child_hi[c] = DEREF(INDEX(vk_aabb, args.bounds, job.first + c)).max;
         lo = min(lo, child_lo[c]);
         hi = max(hi, child_hi[c]);
      }
      vec3 base;
      uvec3 exponent;
      bool ok = count >= 1u && count <= 8u && fit_root(lo, hi, base, exponent);
      uint64_t words[8];
      for (uint t = 0; t < 8u && ok; ++t)
         words[t] = root_word(t, count, HK_AGX3_NODE_INNER, 0u, job.child_slot,
                              args.slot_bias, base, exponent, child_lo[t], child_hi[t], ok);
      if (!ok) {
         DEREF(INDEX(uint32_t, args.status, parent)) = HK_AGX3_LEAF_RANGE;
         return;
      }
      uint64_t node = args.output_bvh + uint64_t(job.root_slot) * 64ul;
      for (uint t = 0; t < 8u; ++t)
         store_word64(node + uint64_t(t) * 8ul, words[t]);
      DEREF(INDEX(vk_aabb, args.bounds, job.position)).min = lo;
      DEREF(INDEX(vk_aabb, args.bounds, job.position)).max = hi;
      DEREF(INDEX(uint32_t, args.status, parent)) = HK_AGX3_LEAF_SUCCESS;
      parent = job.parent;
   }
}

void
main()
{
   uint id = gl_GlobalInvocationID.x;
   if (args.phase == HK_AGX3_REFIT_SAVE)
      save(id);
   else if (args.phase == HK_AGX3_REFIT_PREPARE)
      prepare(id);
   else
      propagate(id);
}
